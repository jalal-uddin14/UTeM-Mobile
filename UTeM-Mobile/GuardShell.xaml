<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.GuardShell"
            xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
            android:TabbedPage.ToolbarPlacement="Bottom"
            xmlns:views="clr-namespace:UTeM_Mobile.Views.Guard">
    <TabBar>
        <Tab Title="Home">
            <Tab.Icon>
                <FontImageSource FontFamily="FAsolid" Glyph="{StaticResource IconHome}" Color="Grey" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="DashboardPage" />
        </Tab>
        <Tab Title="WhatsApp">
            <Tab.Icon>
                <FontImageSource FontFamily="FAbrands" Glyph="{StaticResource IconWhatsapp}" Color="Green" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:WhatsAppPage}" Route="WhatsAppPage" />
        </Tab>
        <Tab Title="Report">
            <Tab.Icon>
                <FontImageSource FontFamily="FAsolid" Glyph="{StaticResource IconEnvelope}" Color="Grey" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ReportSendPage}" Route="ReportSendPage" />
        </Tab>
    </TabBar>
</Shell>