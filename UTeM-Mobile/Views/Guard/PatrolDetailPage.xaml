<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Guard.PatrolDetailPage"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Guard"
             x:DataType="viewModel:PatrolDetailViewModel"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             xmlns:models="clr-namespace:UTeM_Mobile.Core.Models;assembly=UTeM-Mobile.Core"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="50, Auto, Auto, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Patrol Details" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <Grid Grid.Row="1" IsVisible="{Binding IsErrorMessage}" VerticalOptions="CenterAndExpand">
            <ListView BackgroundColor="Transparent" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" Margin="0" HasUnevenRows="True" ItemsSource="{Binding Message_list}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ErrorView">
                        <ViewCell>
                            <Grid>
                                <Frame Padding="5" Margin="0" BackgroundColor="Transparent" HasShadow="True" BorderColor="Transparent">
                                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}"/>
                                </Frame>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="2" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, *" Margin="20, 10" RowSpacing="5">
            <Grid Grid.Row="0">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Campus: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding Patrol.Route.Campus.Name}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="1">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Shift: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding Patrol.Shift.Name}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="2">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Time: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding Patrol.TimeSchedule.Name}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="3">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Start: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding PatrolDetail.Start, StringFormat='{0:dd-MMM-yyyy hh:mm tt}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="4" IsVisible="{Binding PatrolDetail.IsStarted}">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Started at: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding PatrolDetail.StartedAt, StringFormat='{0:dd-MMM-yyyy hh:mm tt}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="5" IsVisible="{Binding PatrolDetail.IsCompleted}">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Completed at: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding PatrolDetail.CompletedAt, StringFormat='{0:dd-MMM-yyyy hh:mm tt}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="5" IsVisible="{Binding PatrolDetail.IsMissed}">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Completed at: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label Text="{Binding PatrolDetail.CompletedAt, StringFormat='{0:dd-MMM-yyyy hh:mm tt}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="6">
                <HorizontalStackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Status: " FontSize="12" TextColor="Black" VerticalTextAlignment="Center"/>
                    <Label IsVisible="{Binding PatrolDetail.IsStarted}" Text="{Binding PatrolDetail.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding PatrolDetail.IsScheduled}" Text="{Binding PatrolDetail.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding PatrolDetail.IsCompleted}" Text="{Binding PatrolDetail.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding PatrolDetail.IsMissed}" Text="{Binding PatrolDetail.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                </HorizontalStackLayout>
            </Grid>
            <StackLayout Grid.Row="7">
                <BoxView HeightRequest="1" Color="Grey"/>
            </StackLayout>
        </Grid>
        <Grid Grid.Row="3" RowDefinitions="Auto, *" Margin="20, 0">
            <StackLayout Grid.Row="0">
                <Label Text="Check Point" HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="16"/>
            </StackLayout>
            <StackLayout Grid.Row="1" IsVisible="{Binding IsBusy}" Margin="0, 20">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
            </StackLayout>
            <StackLayout Grid.Row="1" IsVisible="{Binding IsNotBusy}" Margin="0, 10">
                <ListView x:Name="checkpointsList" ItemsSource="{Binding Patrol.Route.RouteCheckpoints}" SeparatorVisibility="None" RowHeight="60" ItemTapped="ListView_ItemTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:RouteCheckpoint">
                            <ViewCell>
                                <Grid RowDefinitions="Auto" ColumnDefinitions="100, Auto" ColumnSpacing="10">
                                    <StackLayout HorizontalOptions="EndAndExpand">
                                        <Frame IsVisible="{Binding IsChecked}" Grid.Row="0" Grid.Column="0" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15">
                                            <Frame Padding="2" Margin="0" BackgroundColor="{StaticResource CompletedCheckpointColor}" CornerRadius="10" />
                                        </Frame>
                                        <Grid IsVisible="{Binding IsScheduled}" Grid.Row="0" Grid.Column="0" Padding="0" Margin="0" HorizontalOptions="EndAndExpand">
                                            <Frame WidthRequest="30" HeightRequest="30" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15" VerticalOptions="EndAndExpand">
                                                <Frame Grid.Row="0" Padding="2" Margin="0" BackgroundColor="{StaticResource ScheduledCheckpointColor}" CornerRadius="10" />
                                            </Frame>
                                            <Image Grid.Row="0" HeightRequest="25" HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="FAsolid" Glyph="{StaticResource IconLocation}" Color="Red"></FontImageSource>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                        <Frame IsVisible="{Binding IsMissed}" Grid.Row="0" Grid.Column="0" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15">
                                            <Frame Padding="2" Margin="0" BackgroundColor="{StaticResource MissedCheckpointColor}" CornerRadius="10" />
                                        </Frame>
                                        <Frame IsVisible="{Binding NotFound}" Grid.Row="0" Grid.Column="0" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15">
                                            <Frame Padding="2" Margin="0" BackgroundColor="{StaticResource ScheduledCheckpointColor}" CornerRadius="10" />
                                        </Frame>
                                        <BoxView IsVisible="{Binding IsNotLast}" HeightRequest="50" WidthRequest="5" HorizontalOptions="CenterAndExpand" Color="{StaticResource RouteLineColor}"/>
                                    </StackLayout>
                                    <Grid Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Margin="0, 3">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Checkpoint.Name}"/>
                                            <StackLayout IsVisible="{Binding HasSchedule}">
                                                <Label IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModel:PatrolDetailViewModel}}, Path=HasTime}" Text="{Binding Source={RelativeSource AncestorType={x:Type viewModel:PatrolDetailViewModel}}, Path=RouteCheckTimeString}" TextColor="Green"/>
                                                <Label IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModel:PatrolDetailViewModel}}, Path=TimeExceeded}" Text="{Binding Source={RelativeSource AncestorType={x:Type viewModel:PatrolDetailViewModel}}, Path=RouteCheckTimeString}" TextColor="Red"/>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>