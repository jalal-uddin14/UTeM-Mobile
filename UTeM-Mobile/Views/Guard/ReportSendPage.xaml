<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Guard.ReportSendPage"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Guard"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             xmlns:models="clr-namespace:UTeM_Mobile.Core.Models;assembly=UTeM-Mobile.Core"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewModel:ReportSendViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="50, 50, *, *, 80, Auto">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="SoS" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <Grid Grid.Row="1" BackgroundColor="{StaticResource DashboardHeadColor}">
            <Label Text="{Binding User.Name}" TextColor="White" VerticalTextAlignment="Center" HorizontalOptions="CenterAndExpand"/>
        </Grid>
        <Grid Grid.Row="2" IsVisible="{Binding HasPatrol}" ColumnDefinitions="0.3*, 0.7*" RowDefinitions="Auto, Auto, *" Margin="10">
            <Frame Grid.Row="0" Grid.Column="0" Margin="5, 10" Padding="5, 10" HorizontalOptions="FillAndExpand" BorderColor="Gray">
                <StackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Checkpoint:" FontSize="12" HorizontalOptions="CenterAndExpand"/>
                    <Label Text="{Binding PatrolCheckpoint.Checkpoint.Name}"  HorizontalOptions="CenterAndExpand" FontSize="16" FontAttributes="Bold"/>
                </StackLayout>
            </Frame>
            <Frame Grid.Row="1" Grid.Column="0" Margin="5, 0" Padding="5" HorizontalOptions="FillAndExpand" BorderColor="Gray">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                </Frame.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Image Margin="5">
                        <Image.Source>
                            <FontImageSource FontFamily="FAsolid" Size="30" Glyph="{StaticResource IconCamera}" Color="Black"></FontImageSource>
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
            </Frame>
            <Frame IsVisible="{Binding HasPatrol}" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="10" Padding="5">
                <Image Source="{Binding PhotoResult.FullPath}" />
            </Frame>
        </Grid>
        <Grid IsVisible="{Binding HasPatrol}" Grid.Row="3" Margin="5">
            <Frame Padding="15, 5">
                <Editor Placeholder="Description" Text="{Binding Report.Description}" TextColor="Black" MinimumWidthRequest="350" WidthRequest="350" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" Completed="Editor_Completed"/>
            </Frame>
        </Grid>
        <Grid IsVisible="{Binding HasPatrol}" Grid.Row="5">
            <StackLayout Margin="10">
                <Button Text="Send SoS" Style="{StaticResource SubmitButton}" Command="{Binding SendReportCommand}"/>
            </StackLayout>
        </Grid>
        <Grid IsVisible="{Binding HasNoPatrol}" Grid.Row="2">
            <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                <Label Text="Patrol not started." />
            </StackLayout>
        </Grid>
        <StackLayout IsVisible="{Binding IsErrorMessage}" VerticalOptions="CenterAndExpand" Grid.Row="4">
            <ListView BackgroundColor="Transparent" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" Margin="0" HasUnevenRows="True" ItemsSource="{Binding Message_list}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ErrorView">
                        <ViewCell>
                            <Grid>
                                <Frame Padding="5" Margin="0" BackgroundColor="Transparent" HasShadow="True" BorderColor="Transparent">
                                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}"/>
                                </Frame>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
        <StackLayout IsVisible="{Binding IsSuccessMessage}" VerticalOptions="CenterAndExpand">
            <Label Text="{Binding Message}" TextColor="Green" HorizontalOptions="CenterAndExpand" />
        </StackLayout>
    </Grid>
</ContentPage>