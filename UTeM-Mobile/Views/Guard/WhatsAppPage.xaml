<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Guard.WhatsAppPage"
             xmlns:viewmodel="clr-namespace:UTeM_Mobile.ViewModels.Guard"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    <ContentPage.BindingContext>
        <viewmodel:WhatsAppViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
        <Label Text="Opening WhatsApp" />
        <ActivityIndicator IsRunning="True" Color="Black"/>
    </VerticalStackLayout>
</ContentPage>