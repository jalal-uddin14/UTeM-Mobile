<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.ProfilePage"
             BackgroundColor="White"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Shell.NavBarIsVisible="False"
             Title="Profile">
    <ContentPage.BindingContext>
        <viewModel:ProfileViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="100, 50, *, 80">
        <StackLayout Grid.Row="0" Orientation="Horizontal" BackgroundColor="{StaticResource DashboardHeadColor}" Padding="20">
            <Frame BackgroundColor="Transparent" Margin="10, 0" Padding="0" CornerRadius="25" HeightRequest="55">
                <Image Source="logo" HeightRequest="50"/>
            </Frame>
            <StackLayout VerticalOptions="CenterAndExpand">
                <Label Text="{Binding User.Name}" TextColor="White" FontAttributes="Bold"/>
                <Label Text="Supervisor" TextColor="White" FontAttributes="Bold"/>
            </StackLayout>
        </StackLayout>
        <StackLayout Grid.Row="1" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Basic Information" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <StackLayout Grid.Row="2" Padding="5" Margin="50, 10">
            <Grid RowDefinitions="*, *, *, *" ColumnDefinitions="0.5*, 0.5*" RowSpacing="20">
                <Grid Grid.Row="0" Grid.Column="0">
                    <Label Text="Name:" VerticalOptions="CenterAndExpand"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" Padding="0" Margin="0">
                    <Frame Margin="0" Padding="10, 0" VerticalOptions="CenterAndExpand">
                        <Entry Text="{Binding User.Name}"/>
                    </Frame>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0">
                    <Label Text="Email:" VerticalOptions="CenterAndExpand"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Label Text="{Binding User.Email}" VerticalOptions="CenterAndExpand"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="0">
                    <Label Text="Phone number:" VerticalOptions="CenterAndExpand"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1">
                    <Frame Margin="0" Padding="10, 0" VerticalOptions="CenterAndExpand">
                        <Entry Text="{Binding User.PhoneNumber}"/>
                    </Frame>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="0">
                    <Label Text="Role:" />
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1">
                    <Label Text="{Binding User.Role}" />
                </Grid>
            </Grid>
        </StackLayout>
        <Grid Grid.Row="3" Margin="50, 0">
            <Button Text="Update Profile" Command="{Binding UpdateProfileCommand}" CornerRadius="0" HeightRequest="40" BackgroundColor="{StaticResource RedButtonColor}" TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>