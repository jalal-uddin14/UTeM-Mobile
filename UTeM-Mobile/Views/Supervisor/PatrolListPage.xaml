<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.PatrolListPage"
             BackgroundColor="White"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Shell.BackgroundColor="{StaticResource NavbarColor}">
    
    <Shell.TitleView>
        <Image Source="e_smartguardheader.png"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HeightRequest="30"/>
    </Shell.TitleView>

    <ContentPage.BindingContext>
        <viewModel:PatrolListViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="100, 50, *, 50">
        <StackLayout Grid.Row="0" Orientation="Horizontal" BackgroundColor="{StaticResource DashboardHeadColor}" Padding="20">
            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}"/>
            </StackLayout.GestureRecognizers>
            <Frame BackgroundColor="Transparent" Margin="10, 0" Padding="0" CornerRadius="25" HeightRequest="55">
                <Image Source="logo" HeightRequest="50"/>
            </Frame>
            <StackLayout VerticalOptions="CenterAndExpand">
                <Label Text="{Binding User.Name}" TextColor="White" FontAttributes="Bold"/>
                <Label Text="{Binding User.Role}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
            </StackLayout>
        </StackLayout>
        <StackLayout Grid.Row="1" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Patrol Schedule List" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <StackLayout Grid.Row="2" IsVisible="{Binding IsBusy}" Margin="0, 20">
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
        </StackLayout>
        <StackLayout Grid.Row="2" IsVisible="{Binding IsNotBusy}">
            <ListView ItemsSource="{Binding PatrolList}" ItemTapped="ListView_ItemTapped" RowHeight="105" Margin="10" SeparatorVisibility="Default" SeparatorColor="Grey">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Patrol">
                        <ViewCell>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Text="{Binding Route.Name}" TextColor="Green" FontSize="16" FontAttributes="Bold" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <HorizontalStackLayout>
                                        <Label Text="Guard: " TextColor="Grey" FontSize="14" />
                                        <Label Text="{Binding Guard.Name}" TextColor="Black" FontSize="14" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <HorizontalStackLayout>
                                        <Label Text="Date: " TextColor="Grey" FontSize="14" />
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Start, StringFormat='{}{0:D}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid Grid.Row="3">
                                    <HorizontalStackLayout>
                                        <Label Text="Schedule: " TextColor="Grey" FontSize="14" />
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Start, StringFormat='{}{0:t}'}" />
                                                    <Span Text=" - " />
                                                    <Span Text="{Binding End, StringFormat='{} {0:t}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid Grid.Row="4">
                                    <HorizontalStackLayout>
                                        <Label Text="Status: " TextColor="Grey" FontSize="14" />
                                        <Label IsVisible="{Binding IsScheduled}" Text="{Binding Status}" TextColor="Black" FontSize="14" FontAttributes="Bold" />
                                        <Label IsVisible="{Binding IsStarted}" Text="{Binding Status}" TextColor="{StaticResource StartedStatusLabelColor}" FontSize="14" FontAttributes="Bold" />
                                        <Label IsVisible="{Binding IsCompleted}" Text="{Binding Status}" TextColor="{StaticResource CompletedStatusLabelColor}" FontSize="14" FontAttributes="Bold" />
                                        <Label IsVisible="{Binding IsMissed}" Text="{Binding Status}" TextColor="{StaticResource MissedStatusLabelColor}" FontSize="14" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
        <StackLayout Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="5">
                    <Button Text="Guard List" Style="{StaticResource SupervisorDashboardButton}" BackgroundColor="{StaticResource MatGreenButtonColor}" Command="{Binding NavigateToGuardListCommand}"/>
                </Grid>
                <Grid Grid.Column="1" Margin="5">
                    <Button Text="Assign Route" Style="{StaticResource SupervisorDashboardButton}" BackgroundColor="{StaticResource RedButtonColor}" Command="{Binding NavigateToPatrolAddCommand}"/>
                </Grid>
            </Grid>
        </StackLayout>
    </Grid>
</ContentPage>