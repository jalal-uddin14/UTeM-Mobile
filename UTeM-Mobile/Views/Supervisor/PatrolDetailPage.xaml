<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.PatrolDetailPage"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Title="PatrolDetailPage">
    <ContentPage.BindingContext>
        <viewModel:PatrolDetailViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label Text="{Binding Patrol.Guard.Name, StringFormat='Guard name: {0}'}" />
        <Label Text="{Binding Patrol.Route.Name, StringFormat='Route name: {0}'}" />
        <ListView ItemsSource="{Binding Patrol.Route.RouteCheckpoints}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:RouteCheckpoint">
                    <ViewCell>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Label Text="{Binding Checkpoint.Name, StringFormat='Checkpoint name: {0}'}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Label Text="{Binding Checkpoint.Latitude, StringFormat='Checkpoint Latitude: {0}'}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Label Text="{Binding Checkpoint.Longitude, StringFormat='Checkpoint Longitude: {0}'}" />
                            </Grid>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>