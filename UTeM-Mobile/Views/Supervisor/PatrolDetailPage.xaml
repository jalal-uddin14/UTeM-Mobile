<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.PatrolDetailPage"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             xmlns:models="clr-namespace:UTeM_Mobile.Core.Models;assembly=UTeM-Mobile.Core"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    <ContentPage.BindingContext>
        <viewModel:PatrolDetailViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="50, Auto, 80, Auto, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Patrol Details" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <Grid Grid.Row="1" IsVisible="{Binding IsErrorMessage}" VerticalOptions="CenterAndExpand">
            <ListView BackgroundColor="Transparent" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" Margin="0" HasUnevenRows="True" ItemsSource="{Binding Message_list}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ErrorView">
                        <ViewCell>
                            <Grid>
                                <Frame Padding="5" Margin="0" BackgroundColor="Transparent" HasShadow="True" BorderColor="Transparent">
                                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}"/>
                                </Frame>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, 10" ColumnSpacing="10" Margin="20, 10">
            <Grid Grid.Column="0" Grid.RowSpan="2" VerticalOptions="CenterAndExpand">
                <Frame Padding="0" Margin="0" BorderColor="Transparent" CornerRadius="25">
                    <Image Source="guard.jpg" HeightRequest="50" VerticalOptions="CenterAndExpand"/>
                </Frame>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="0">
                <Label Text="{Binding Patrol.Guard.Name}" TextColor="Black" VerticalTextAlignment="End"/>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="1">
                <Label Text="Guard" TextColor="Black" VerticalTextAlignment="Start"/>
            </Grid>
            <Grid Grid.ColumnSpan="2" Grid.Row="2">
                <BoxView HeightRequest="1" Color="Grey"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="20, 10" RowSpacing="5">
            <StackLayout Grid.Row="0">
                <Label Text="Route name" FontSize="12" TextColor="Black"/>
                <Label Text="{Binding Patrol.Route.Name}" FontAttributes="Bold" TextColor="Black"/>
            </StackLayout>
            <StackLayout Grid.Row="1">
                <Label Text="Patrol schedule" FontSize="12" TextColor="Black"/>
                <HorizontalStackLayout>
                    <Label Text="{Binding Patrol.Start, StringFormat='{0:D}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </StackLayout>
            <StackLayout Grid.Row="2">
                <Label Text="Patrol schedule" FontSize="12" TextColor="Black"/>
                <HorizontalStackLayout>
                    <Label Text="{Binding Patrol.Start, StringFormat='{0:t} - '}" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Patrol.End, StringFormat=' {0:t}'}" FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>
            </StackLayout>
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                <StackLayout Grid.Column="0">
                    <Label Text="Status" FontSize="12" TextColor="Black"/>
                    <Label IsVisible="{Binding Patrol.IsStarted}" Text="{Binding Patrol.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding Patrol.IsScheduled}" Text="{Binding Patrol.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding Patrol.IsCompleted}" Text="{Binding Patrol.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                    <Label IsVisible="{Binding Patrol.IsMissed}" Text="{Binding Patrol.Status}" FontAttributes="Bold" TextColor="{StaticResource StartedStatusLabelColor}"/>
                </StackLayout>
                <StackLayout Grid.Column="1" IsVisible="{Binding PatrolRunning}">
                    <Button IsVisible="{Binding ShowGPS}" Text="{StaticResource IconMapRoute}" FontFamily="FAsolid" BackgroundColor="Transparent" TextColor="Black" FontSize="22" Clicked="Button_Clicked"/>
                    <Button IsVisible="{Binding ShowMapRoute}" Text="{StaticResource IconGps}" FontFamily="FAsolid" BackgroundColor="Transparent" TextColor="Black" FontSize="22" Clicked="Button_Clicked"/>
                </StackLayout>
            </Grid>
            <StackLayout Grid.Row="4">
                <BoxView HeightRequest="1" Color="Grey"/>
            </StackLayout>
        </Grid>
        <Grid IsVisible="{Binding ShowMapRoute}" Grid.Row="4" RowDefinitions="Auto, *" Margin="20, 0">
            <StackLayout Grid.Row="0">
                <Label Text="Check Point" HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="16"/>
            </StackLayout>
            <StackLayout Grid.Row="1" IsVisible="{Binding IsBusy}" Margin="0, 20">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
            </StackLayout>
            <StackLayout Grid.Row="1" IsVisible="{Binding IsNotBusy}" Margin="0, 10">
                <ListView ItemsSource="{Binding Patrol.Route.RouteCheckpoints}" SeparatorVisibility="None" RowHeight="60" ItemTapped="ListView_ItemTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:RouteCheckpoint">
                            <ViewCell>
                                <Grid RowDefinitions="Auto" ColumnDefinitions="100, Auto" ColumnSpacing="10">
                                    <StackLayout HorizontalOptions="EndAndExpand">
                                        <Frame IsVisible="{Binding IsChecked}" Grid.Row="0" Grid.Column="0" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15">
                                            <Frame Padding="2" Margin="0" BackgroundColor="{StaticResource CompletedCheckpointColor}" CornerRadius="10" />
                                        </Frame>
                                        <Grid IsVisible="{Binding IsScheduled}" Grid.Row="0" Grid.Column="0" Padding="0" Margin="0" HorizontalOptions="EndAndExpand">
                                            <Frame WidthRequest="30" HeightRequest="30" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15" VerticalOptions="EndAndExpand">
                                                <Frame Grid.Row="0" Padding="2" Margin="0" BackgroundColor="{StaticResource ScheduledCheckpointColor}" CornerRadius="10" />
                                            </Frame>
                                            <Image Grid.Row="0" HeightRequest="25" HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="FAsolid" Glyph="{StaticResource IconLocation}" Color="Red"></FontImageSource>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                        <Frame IsVisible="{Binding NotFound}" Grid.Row="0" Grid.Column="0" Padding="3" Margin="0" BackgroundColor="{StaticResource CheckpointBorderColor}" CornerRadius="15">
                                            <Frame Padding="2" Margin="0" BackgroundColor="{StaticResource ScheduledCheckpointColor}" CornerRadius="10" />
                                        </Frame>
                                        <BoxView IsVisible="{Binding IsNotLast}" HeightRequest="50" WidthRequest="5" HorizontalOptions="CenterAndExpand" Color="{StaticResource RouteLineColor}"/>
                                    </StackLayout>
                                    <Grid Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Margin="0, 3">
                                        <Label Text="{Binding Checkpoint.Name}"/>
                                    </Grid>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
        </Grid>
        <Grid IsVisible="{Binding ShowGPS}" Grid.Row="4" Margin="10">
            <maps:Map x:Name="map" Style="{StaticResource MapStyle}"/>

        </Grid>
    </Grid>
</ContentPage>