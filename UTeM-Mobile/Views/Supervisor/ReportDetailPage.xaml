<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.ReportDetailPage"
             BackgroundColor="White"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Shell.NavBarIsVisible="False"
             Title="Report Detail">
    <ContentPage.BindingContext>
        <viewModel:ReportDetailViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="50, 80, Auto, Auto, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="SoS Detail" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <StackLayout Grid.Row="1" BackgroundColor="{StaticResource White}" Padding="10">
            <StackLayout Orientation="Horizontal">
                <Frame BackgroundColor="Transparent" Margin="10, 0" Padding="0" CornerRadius="25" HeightRequest="45">
                    <Image Source="logo" HeightRequest="40"/>
                </Frame>
                <StackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="{Binding Report.GuardName}" TextColor="Black" FontAttributes="Bold"/>
                    <Label Text="Guard" TextColor="Gray" FontAttributes="Bold"/>
                </StackLayout>
            </StackLayout>
            <BoxView HeightRequest="1" Color="Grey" Margin="0, 10"/>
        </StackLayout>
        <StackLayout Grid.Row="2" BackgroundColor="Transparent" Margin="20, 0">
            <Label Text="{Binding Report.Difference, StringFormat='{0} ago'}" TextColor="Gray" FontSize="12"/>
            <Frame Margin="0, 10" Padding="5, 10" HorizontalOptions="StartAndExpand" BorderColor="Gray">
                <StackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Route Name:" FontSize="12" HorizontalOptions="CenterAndExpand"/>
                    <Label Text="{Binding Report.RouteName}"  HorizontalOptions="CenterAndExpand" FontSize="16" FontAttributes="Bold"/>
                </StackLayout>
            </Frame>
        </StackLayout>
        <StackLayout Grid.Row="3" BackgroundColor="Transparent" Margin="20, 0">
            <Frame Margin="0, 10" Padding="5, 10" HorizontalOptions="FillAndExpand" BorderColor="{StaticResource Gray200}" CornerRadius="0">
                <Label Text="{Binding Report.Description}"  HorizontalOptions="StartAndExpand" FontSize="14" FontAttributes="Bold"/>
            </Frame>
        </StackLayout>
        <StackLayout Grid.Row="4" BackgroundColor="Transparent" Margin="20, 0">
            <Image Source="{Binding Report.FilePath}" />
        </StackLayout>
    </Grid>
</ContentPage>