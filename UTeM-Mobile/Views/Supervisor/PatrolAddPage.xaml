<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.PatrolAddPage"
             BackgroundColor="{StaticResource FormBackgroundColor}"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             x:DataType="viewModel:PatrolAddViewModel"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             xmlns:models="clr-namespace:UTeM_Mobile.Core.Models;assembly=UTeM-Mobile.Core"
             Shell.NavBarIsVisible="False"
             Title="Add Patrol">
    
    <ScrollView>
        <Grid RowDefinitions="50, Auto, Auto, Auto">
            <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
                <Label Text="Assign Route" Style="{StaticResource HeaderLabel}"/>
            </StackLayout>
            <Grid Grid.Row="1" Margin="20, 10" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                <StackLayout Grid.Row="0">
                    <Grid RowDefinitions="Auto, Auto">
                        <StackLayout Grid.Row="0" Orientation="Horizontal">
                            <Label Text="Guard"  Style="{StaticResource AddFormTitleLabel}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"/>
                            <Button Text="Reload data" HorizontalOptions="EndAndExpand" Padding="7, 5" Margin="0" Command="{Binding ReloadDataCommand}"/>
                        </StackLayout>
                        
                        <Frame Grid.Row="1" Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsGuardNotVisible}">
                            <Label Text="Guard list loading.." TextColor="Black" />
                        </Frame>
                        <Frame Grid.Row="1" Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsGuardVisible}">
                            <Picker x:Name="guardPicker"
                                    TextColor="{StaticResource Black}"
                                    FontSize="16"
                                    Title="Select Guard"
                                    ItemsSource="{Binding GuardList}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedGuard}"/>
                        </Frame>
                    </Grid>
                </StackLayout>
                <StackLayout Grid.Row="1">
                    <Label Text="Campus" Style="{StaticResource AddFormTitleLabel}"/>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsCampusNotVisible}">
                        <Label Text="Campus list loading.." TextColor="Black" />
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsCampusVisible}">
                        <Picker x:Name="campusPicker"
                    TextColor="{StaticResource Black}"
                    FontSize="16"
                    Title="Select Campus"
                    ItemsSource="{Binding CampusList}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCampus}"/>
                    </Frame>
                </StackLayout>
                <StackLayout Grid.Row="2">
                    <Label Text="Route" Style="{StaticResource AddFormTitleLabel}"/>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsRouteNotVisible}">
                        <Label Text="Route list loading.." TextColor="Black" />
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsRouteVisible}">
                        <Picker x:Name="routePicker"
                                TextColor="{StaticResource Black}"
                                FontSize="16"
                                Title="Select Route"
                                ItemsSource="{Binding RouteList}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedRoute}"/>
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsRouteSelected}">
                        <Label Text="{Binding SelectedRouteString}" />
                    </Frame>
                </StackLayout>
                <StackLayout Grid.Row="3">
                    <Label Text="Shift" Style="{StaticResource AddFormTitleLabel}"/>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsShiftNotVisible}">
                        <Label Text="Shift list loading.." TextColor="Black" />
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsShiftVisible}">
                        <Picker x:Name="shiftPicker"
                                TextColor="{StaticResource Black}"
                                FontSize="16"
                                Title="Select Shift"
                                ItemsSource="{Binding ShiftList}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedShift}"/>
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsShiftSelected}">
                        <Label Text="{Binding SelectedShiftString}" />
                    </Frame>
                </StackLayout>
                <StackLayout Grid.Row="4">
                    <Label Text="Time" Style="{StaticResource AddFormTitleLabel}"/>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsTimeNotVisible}">
                        <Label Text="Time list loading.." TextColor="Black" />
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsTimeVisible}">
                        <Picker x:Name="timePicker"
                                TextColor="{StaticResource Black}"
                                FontSize="16"
                                Title="Select Time"
                                ItemsSource="{Binding TimeScheduleList}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedTime}"/>
                    </Frame>
                    <Frame Style="{StaticResource AddFormFrame}" IsVisible="{Binding IsTimeSelected}">
                        <Label Text="{Binding SelectedTimeString}" />
                    </Frame>
                </StackLayout>
                <StackLayout Grid.Row="5">
                    <Label Text="Start"  Style="{StaticResource AddFormTitleLabel}"/>
                    <HorizontalStackLayout>
                        <Frame Style="{StaticResource AddFormFrame}">
                            <DatePicker Date="{Binding StartDate}" Format="dd/MM/yyyy" FontSize="16"/>
                        </Frame>
                    </HorizontalStackLayout>
                </StackLayout>
                <StackLayout Grid.Row="6">
                    <Label Text="End"  Style="{StaticResource AddFormTitleLabel}"/>
                    <HorizontalStackLayout>
                        <Frame Style="{StaticResource AddFormFrame}">
                            <DatePicker Date="{Binding EndDate}" Format="dd/MM/yyyy" FontSize="16"/>
                        </Frame>
                    </HorizontalStackLayout>
                </StackLayout>
                <HorizontalStackLayout Grid.Row="7" VerticalOptions="CenterAndExpand">
                    <CheckBox IsChecked="{Binding IsTimerEnable}" Color="{StaticResource LoginButtonColor}"/>
                    <Label Text="Timer enable"  Style="{StaticResource AddFormTitleLabel}" VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
            </Grid>
            <Grid Grid.Row="2" Margin="10" >
                <Button Text="Assign" Style="{StaticResource SubmitButton}" Command="{Binding CreatePatrolCommand}"/>
            </Grid>

            <Grid Grid.Row="3" IsVisible="{Binding IsErrorMessage}" VerticalOptions="CenterAndExpand">
                <ListView BackgroundColor="Transparent" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" Margin="0" HasUnevenRows="True" ItemsSource="{Binding Message_list}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ErrorView">
                            <ViewCell>
                                <Grid>
                                    <Frame Padding="5" Margin="0" BackgroundColor="Transparent" HasShadow="True" BorderColor="Transparent">
                                        <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}"/>
                                    </Frame>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>