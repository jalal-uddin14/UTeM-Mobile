<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.PatrolAddPage"
             BackgroundColor="White"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Shell.NavBarIsVisible="False"
             Title="Add Patrol">

    <ContentPage.BindingContext>
        <viewModel:PatrolAddViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="50, *, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Assign Route" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
            <StackLayout Grid.Row="0">
                <Label Text="Guard" />
                <Frame Padding="5, -7" Margin="0, 7">
                    <Picker x:Name="guardPicker"
                        TextColor="{StaticResource Primary}"
                        Title="Select Guard"
                        ItemsSource="{Binding GuardList}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedGuard}"/>
                </Frame>
            </StackLayout>
            <StackLayout Grid.Row="1">
                <Label Text="Route" />
                <Frame Padding="5, -7" Margin="0, 7">
                    <Picker x:Name="routePicker"
                        TextColor="{StaticResource Primary}"
                        Title="Select Route"
                        ItemsSource="{Binding RouteList}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedRoute}"/>
                </Frame>
            </StackLayout>
            <StackLayout Grid.Row="2">
                <Label Text="Date" />
            </StackLayout>
            <StackLayout Grid.Row="3">
                <Label Text="Start" />
                <HorizontalStackLayout>
                    <Frame Padding="5, -7" Margin="0, 7">
                        <DatePicker Date="{Binding StartDate}" />
                    </Frame>
                    <Frame Padding="5, -7" Margin="0, 7">
                        <TimePicker Time="{Binding StartTime}" />
                    </Frame>
                </HorizontalStackLayout>
            </StackLayout>
            <StackLayout Grid.Row="4">
                <Label Text="End" />
                <HorizontalStackLayout>
                    <Frame Padding="5, -7" Margin="0, 7">
                        <DatePicker Date="{Binding EndDate}" />
                    </Frame>
                    <Frame Padding="5, -7" Margin="0, 7">
                        <TimePicker Time="{Binding EndTime}" />
                    </Frame>
                </HorizontalStackLayout>
            </StackLayout>
        </Grid>
        <Grid Grid.Row="2" Margin="10" >
            <Button Text="Assign" Style="{StaticResource SubmitButton}" Command="{Binding CreatePatrolCommand}"/>
        </Grid>
    </Grid>
    
</ContentPage>