<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.ReportListPage"
             BackgroundColor="White"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             xmlns:model="clr-namespace:UTeM_Mobile.Data.Models;assembly=UTeM-Mobile.Data"
             Shell.NavBarIsVisible="False"
             Title="Report List">

    <ContentPage.BindingContext>
        <viewModel:ReportListViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="50, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="SoS List" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <StackLayout Grid.Row="1" IsVisible="{Binding IsBusy}" Margin="0, 20">
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
        </StackLayout>
        <StackLayout Grid.Row="1" IsVisible="{Binding IsNotBusy}" Margin="20, 10">
            <ListView ItemsSource="{Binding ReportList}" ItemTapped="ListView_ItemTapped" RowHeight="60">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Text="{Binding GuardName, StringFormat='{0}'}" FontAttributes="Bold"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Text="{Binding Difference, StringFormat='{0}h ago'}" FontSize="12"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Label Text="{Binding Description, StringFormat='{0}'}" FontSize="12"/>
                                </Grid>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackLayout>
    </Grid>
</ContentPage>