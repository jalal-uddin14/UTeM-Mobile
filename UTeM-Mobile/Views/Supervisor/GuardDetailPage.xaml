<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.GuardDetailPage"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             Title="Guard Detail">
    <ContentPage.BindingContext>
        <viewModel:GuardDetailViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label Text="{Binding Guard.Name, StringFormat='Name: {0}'}" />
        <Label Text="{Binding Guard.Email, StringFormat='Email: {0}'}" />
    </VerticalStackLayout>
</ContentPage>