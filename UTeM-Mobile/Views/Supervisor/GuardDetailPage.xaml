<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTeM_Mobile.Views.Supervisor.GuardDetailPage"
             xmlns:viewModel="clr-namespace:UTeM_Mobile.ViewModels.Supervisor"
             x:DataType="viewModel:GuardDetailViewModel"
             xmlns:models="clr-namespace:UTeM_Mobile.Core.Models;assembly=UTeM-Mobile.Core"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    
    <Grid RowDefinitions="50, 80, Auto, *">
        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource HeadingColor}" Padding="5">
            <Label Text="Guard List" Style="{StaticResource HeaderLabel}"/>
        </StackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" BackgroundColor="{StaticResource DashboardHeadColor}" Padding="10, 0">
            <Grid Grid.Column="0" Grid.RowSpan="2" VerticalOptions="CenterAndExpand">
                <Frame Padding="0" Margin="0" BorderColor="Transparent" CornerRadius="25">
                    <Image Source="guard.jpg" HeightRequest="50" VerticalOptions="CenterAndExpand"/>
                </Frame>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="0">
                <Label Text="{Binding Guard.Name}" TextColor="White" VerticalTextAlignment="End"/>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="1">
                <Label Text="Guard" TextColor="White" VerticalTextAlignment="Start"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" IsVisible="{Binding IsErrorMessage}" VerticalOptions="CenterAndExpand">
            <ListView BackgroundColor="Transparent" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" Margin="0" HasUnevenRows="True" ItemsSource="{Binding Message_list}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ErrorView">
                        <ViewCell>
                            <Grid>
                                <Frame Padding="5" Margin="0" BackgroundColor="Transparent" HasShadow="True" BorderColor="Transparent">
                                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}"/>
                                </Frame>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackLayout Grid.Row="3" Margin="50, 10">
            <Grid RowDefinitions="*, *" ColumnDefinitions="0.5*, 0.5*">
                <Grid Grid.Row="0" Grid.Column="0">
                    <Label Text="Email:" />
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Label Text="{Binding Guard.Email}" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0">
                    <Label Text="Phone number:" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Label Text="{Binding Guard.PhoneNumber}" />
                </Grid>
            </Grid>
        </StackLayout>
    </Grid>
</ContentPage>